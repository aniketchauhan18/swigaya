{
  "name": "swigaya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tabler/icons-react": "^3.50.0",
    "@vinext/cloudflare": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "groq-sdk": "^1.6.0",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "prisma generate",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate:local": "wrangler d1 migrations apply swigaya-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply swigaya-db --remote"
  }
}
